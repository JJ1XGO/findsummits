        <mxCell id="geojson-label" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;" value="証跡 GeoJSON" vertex="1">
          <mxGeometry height="30" width="100" x="810" y="545" as="geometry" />
        </mxCell>

        <!-- エッジ：国土地理院 → システム（標高タイル） -->
        <mxCell id="e-gsi" parent="1" source="gsi" target="sys-box" style="edgeStyle=orthogonalEdgeStyle;html=1;" value="標高タイル PNG&#xa;（DEM5a/b/c・DEM10b）" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- エッジ：国土交通省 → システム（N03） -->
        <mxCell id="e-mlit" parent="1" source="mlit" target="sys-box" style="edgeStyle=orthogonalEdgeStyle;html=1;" value="N03 行政区域&#xa;GeoJSON" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- エッジ：SOTA Reflector → システム（summitslist） -->
        <mxCell id="e-sota-in" parent="1" source="sota-in" target="sys-box" style="edgeStyle=orthogonalEdgeStyle;html=1;" value="summitslist.csv" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- エッジ：申請担当者 → システム（操作） -->
        <mxCell id="e-user-in" parent="1" source="user" target="sys-box" style="edgeStyle=orthogonalEdgeStyle;html=1;" value="操作・メッシュコードリスト" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- エッジ：システム → 申請書XLSX -->
        <mxCell id="e-xlsx" parent="1" source="sys-box" target="xlsx" style="edgeStyle=orthogonalEdgeStyle;html=1;" value="" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- エッジ：システム → エビデンスCSV -->
        <mxCell id="e-csv" parent="1" source="sys-box" target="csv" style="edgeStyle=orthogonalEdgeStyle;html=1;" value="" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- エッジ：システム → 証跡GeoJSON -->
        <mxCell id="e-geojson" parent="1" source="sys-box" target="geojson" style="edgeStyle=orthogonalEdgeStyle;html=1;" value="" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- エッジ：申請書XLSX → SOTA日本支部マネージャ -->
        <mxCell id="e-xlsx-mgr" parent="1" source="xlsx" target="sota-mgr" style="edgeStyle=orthogonalEdgeStyle;html=1;" value="申請提出" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
