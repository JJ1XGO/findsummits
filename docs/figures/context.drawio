          <mxGeometry height="30" width="100" x="810" y="415" as="geometry" />
        </mxCell>

        <!-- 成果物：証跡GeoJSON -->
        <mxCell id="geojson" parent="1" style="dashed=0;outlineConnect=0;html=1;align=center;labelPosition=center;verticalLabelPosition=bottom;verticalAlign=top;shape=mxgraph.weblogos.json;" value="" vertex="1">
          <mxGeometry height="60" width="60" x="830" y="480" as="geometry" />
